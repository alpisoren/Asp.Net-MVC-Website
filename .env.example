# docker-compose.yml için ayarlar. Bu dosyayı ".env" adıyla kopyalayıp doldurun. ".env" git'e EKLENMEZ.

# Sitenin kalıcı adresi (https:// olmadan). Caddy bunun için sertifika alır.
ALAN_ADI=www.alanadi.com.tr
# Çıplak alan adı; www'ye 301 ile yönlenir. Kullanmıyorsanız boş bırakın.
ALAN_ADI_CIPLAK=alanadi.com.tr

# SQL Server "sa" şifresi: en az 8 karakter, büyük/küçük harf, rakam ve sembol içermeli.
SQL_SA_SIFRE=

# İletişim formundan gelen mesajların gideceği adres
ILETISIM_ALICI=

# E-posta (Yandex için uygulama şifresi)
SMTP_SUNUCU=smtp.yandex.com
SMTP_PORT=587
SMTP_KULLANICI=
SMTP_SIFRE=
SMTP_GONDEREN=

# Google araçları (boş = kapalı)
GOOGLE_SITE_DOGRULAMA=
GOOGLE_ANALYTICS_ID=

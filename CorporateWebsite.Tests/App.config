<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <connectionStrings>
    <!-- Veritabanı testleri için geçici LocalDB veritabanı. |DataDirectory| testte %TEMP% altındaki bir klasöre ayarlanır;
         geliştiricinin KurumsalDB veritabanına dokunulmaz. -->
    <add name="KurumsalDB" connectionString="Server=(localdb)\MSSQLLocalDB;Database=KurumsalBirimTest;AttachDbFilename=|DataDirectory|\KurumsalBirimTest.mdf;Integrated Security=True;Connect Timeout=60" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <entityFramework>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
</configuration>

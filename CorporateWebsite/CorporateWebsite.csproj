<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CorporateWebsite</RootNamespace>
    <AssemblyName>CorporateWebsite</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Kullanıcıya özel gizli ayarlar (SMTP şifresi vb.) geliştirmede "dotnet user-secrets" ile tutulur -->
    <UserSecretsId>kurumsal-web-7c1f2a9e</UserSecretsId>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Veri katmanı: mevcut veritabanı ve migration'lar korunur (EF6, .NET 10'da da çalışır) -->
    <PackageReference Include="EntityFramework" Version="6.5.2" />
    <PackageReference Include="Microsoft.EntityFramework.SqlServer" Version="6.5.2" />
    <!-- Zengin metin temizleme -->
    <PackageReference Include="HtmlSanitizer" Version="10.0.1120" />
    <!-- Sayfalama -->
    <PackageReference Include="X.PagedList.Mvc.Core" Version="10.6.0" />
    <!-- Resim küçültme (MIT); Linux/Docker için yerel kütüphane -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
    <!-- İstek sınırlayıcı (SpamKorumasi) bellek önbelleği -->
    <PackageReference Include="System.Runtime.Caching" Version="10.0.14" />
    <!-- Microsoft.Data.SqlClient'ın dolaylı bağımlılığındaki güvenlik açığını (GHSA-846f-f764-76mx) kapatır -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Çalışma anında oluşan dosyalar yayın paketine girmez -->
    <Content Remove="App_Data\**" />
    <None Remove="App_Data\**" />
    <Content Update="wwwroot\Uploads\**" CopyToPublishDirectory="Never" />
    <!-- Gizli ayar dosyaları hiçbir koşulda yayın paketine girmez (sunucuda ortam değişkeni ya da ayrı dosya).
         smtp.config / connectionStrings.config: eski .NET Framework sürümünden kalan yerel dosyalar. -->
    <Content Remove="appsettings.Production.json;smtp.config;connectionStrings.config" />
    <None Remove="smtp.config;connectionStrings.config" />
  </ItemGroup>

</Project>

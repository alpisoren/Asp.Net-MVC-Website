<?xml version="1.0" encoding="utf-8"?>
<!-- Bu dosyayı connectionStrings.config adıyla kopyalayıp kendi SQL Server bilgilerinizi girin.
     connectionStrings.config git'e eklenmez. -->
<connectionStrings>
  <!-- Örnek: tam SQL Server -->
  <add name="KurumsalDB" connectionString="Server=DESKTOP-6L4LQHP;Database=KurumsalDB;Integrated Security=True" providerName="System.Data.SqlClient" />
  <!-- Örnek: LocalDB. "Connect Timeout=60": LocalDB ilk açılışta yavaş başlar; kısa süre dolarsa EF veritabanını
       yok sanıp yeniden oluşturmaya çalışır ve "Cannot create file ... KurumsalDB.mdf because it already exists" hatası verir.
  <add name="KurumsalDB" connectionString="Server=(localdb)\MSSQLLocalDB;Database=KurumsalDB;Integrated Security=True;Connect Timeout=60" providerName="System.Data.SqlClient" />
  -->
</connectionStrings>

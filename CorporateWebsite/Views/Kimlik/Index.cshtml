@model IEnumerable<CorporateWebsite.Models.Model.Kimlik>
@{
    ViewBag.Title = "Site Kimliği";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<p class="kp-muted">Sitenin adı, logosu ve arama motorlarında görünen açıklaması.</p>

@if (!Model.Any())
{
    <div class="kp-empty"><i class="fa fa-id-card-o" aria-hidden="true"></i><p>Site kimliği kaydı bulunamadı. Veritabanına bir kayıt eklenmesi gerekiyor.</p></div>
}

@foreach (var item in Model)
{
    <dl class="dl-horizontal">
        <dt>Logo</dt>
        <dd>
            @if (!string.IsNullOrEmpty(item.LogoUrl))
            {<img class="kp-thumb" src="@item.LogoUrl" alt="Site logosu" />}
            else
            {<span class="kp-muted">Logo yüklenmemiş (sitede ünvan yazısı gösterilir)</span>}
        </dd>
        <dt>Ünvan</dt>
        <dd>@(string.IsNullOrEmpty(item.Unvan) ? "—" : item.Unvan)</dd>
        <dt>Site başlığı</dt>
        <dd>@item.Title</dd>
        <dt>Açıklama</dt>
        <dd>@item.Description</dd>
        <dt>Anahtar kelimeler</dt>
        <dd>@item.Keywords</dd>
    </dl>
    <div class="kp-form-actions">
        <a class="btn btn-primary" href="/Kimlik/Edit/@item.KimlikId"><i class="fa fa-pencil" aria-hidden="true"></i>Düzenle</a>
    </div>
}

@model CorporateWebsite.Models.Model.Slider

@{
    ViewBag.Title = "Slaytı Sil";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}


<div class="alert alert-warning" role="alert"><i class="fa fa-exclamation-triangle" aria-hidden="true"></i> Bu slayt ve resmi kalıcı olarak silinecek. Emin misiniz?</div>
<div>
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.Baslik)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Baslik)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Aciklama)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Aciklama)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.ResimURL)
        </dt>

        <dd>
            <img src="@Model.ResimURL" width="150" height="50" />
        </dd>

    </dl>

    @using (Html.BeginForm()) {
        @Html.AntiForgeryToken()

        <div class="kp-form-actions">
            <button type="submit" class="btn btn-danger"><i class="fa fa-trash-o" aria-hidden="true"></i>Evet, Sil</button>
            @Html.ActionLink("Vazgeç", "Index", null, new { @class = "btn btn-default" })
        </div>
    }
</div>

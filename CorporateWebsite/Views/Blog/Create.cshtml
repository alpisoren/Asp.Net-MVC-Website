@model CorporateWebsite.Models.ViewModel.BlogFormModeli

@{
    ViewBag.Title = "Yeni Blog Yazısı";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}


<div class="form">

   <form class="form-validate form-horizontal" id="feedback_form" method="post" action="/Blog/Create" enctype="multipart/form-data">
     @Html.AntiForgeryToken()
     @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group ">
            <label for="cname" class="control-label col-lg-2">Başlık <span class="required">*</span></label>
            <div class="col-lg-10">
                <input class="form-control" id="Baslik" name="Baslik" maxlength="200" type="text" required value="@Model.Baslik" />
                @Html.ValidationMessageFor(model => model.Baslik, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group ">
            <label for="cemail" class="control-label col-lg-2">Kategori <span class="required">*</span></label>
            <div class="col-lg-10">
                @Html.DropDownList("KategoriId", null, "(Kategorisiz)", new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.KategoriId, "", new { @class = "text-danger" })
            </div>
        </div>

    @await Html.PartialAsync("_BlogEkAlanlar", Model)

        <div class="form-group ">
            <label for="curl" class="control-label col-lg-2">İçerik </label>
            <div class="col-lg-10">
                <textarea class="form-control kp-zengin-editor" name="Icerik" id="Icerik">@Model.Icerik</textarea>
            </div>
        </div>

        <div class="form-group ">
            <label for="cname" class="control-label col-lg-2">Resim</label>
            <div class="col-lg-10">
                <input class="form-control" id="ResimURL" name="ResimURL" type="file" accept=".jpg,.jpeg,.png" />
            </div>
        </div>

        <div class="form-group">
            <div class="col-lg-offset-2 col-lg-10">
                <button type="submit" class="btn btn-primary"><i class="fa fa-check" aria-hidden="true"></i>Kaydet</button>
                <a class="btn btn-default" href="/Blog/Index">Vazgeç</a>
            </div>
        </div>
        </form>
    
</div>


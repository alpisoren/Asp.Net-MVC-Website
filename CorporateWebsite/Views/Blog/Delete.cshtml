@model CorporateWebsite.Models.Model.Blog

@{
    ViewBag.Title = "Yazıyı Sil";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}



<div class="alert alert-warning" role="alert"><i class="fa fa-exclamation-triangle" aria-hidden="true"></i> "@Model.Baslik" yazısı ve ona ait yorumlar kalıcı olarak silinecek. Emin misiniz?</div>
<div>
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.BlogId)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.BlogId)
        </dd>
       
        <dt>
            @Html.DisplayNameFor(model => model.Baslik)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Baslik)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Icerik)
        </dt>

        <dd>
            @Html.Raw(HtmlTemizleyici.Temizle(Model.Icerik))
        </dd>

    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="kp-form-actions">
            <button type="submit" class="btn btn-danger"><i class="fa fa-trash-o" aria-hidden="true"></i>Evet, Sil</button>
            @Html.ActionLink("Vazgeç", "Index", null, new { @class = "btn btn-default" })
        </div>
    }
</div>
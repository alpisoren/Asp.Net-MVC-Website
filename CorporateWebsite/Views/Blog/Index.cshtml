@model IEnumerable<CorporateWebsite.Models.Model.Blog>
@using CorporateWebsite.Helper;
@{
    ViewBag.Title = "Blog Yazıları";
    ViewBag.YeniEkleUrl = "/Blog/Create";
    ViewBag.YeniEkleMetni = "Yeni Yazı";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@if (!Model.Any())
{
    <div class="kp-empty"><i class="fa fa-file-text-o" aria-hidden="true"></i><p>Henüz blog yazısı yok.</p><a class="btn btn-primary" href="/Blog/Create">İlk yazıyı ekleyin</a></div>
}
else
{
    <div class="table-responsive">
        <table class="table kp-table" data-tablo>
            <thead>
                <tr>
                    <th scope="col">Resim</th>
                    <th scope="col">Başlık</th>
                    <th scope="col">Kategori</th>
                    <th scope="col">Yayın</th>
                    <th scope="col"><span class="sr-only">İşlemler</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ResimURL))
                            {<img class="kp-thumb" src="@item.ResimURL" alt="" />}
                            else
                            {<span class="kp-muted" aria-label="Resim yok">—</span>}
                        </td>
                        <td><strong>@item.Baslik</strong></td>
                        <td>@(item.Kategori?.KategoriAd ?? "—")</td>
                        <td data-order="@item.YayinTarihi.ToString("yyyyMMddHHmm")">
                            @item.YayinTarihi.ToString("d MMM yyyy", TarihHelper.Tr)
                            @if (item.YayinTarihi > DateTime.Now)
                            {<br /><span class="kp-status kp-status-wait">Planlandı</span>}
                        </td>
                        <td>
                            <a class="kp-row-action" href="@SeoHelper.BlogUrl(item.Baslik, item.BlogId)" target="_blank" rel="noopener" title="Sitede görüntüle"><i class="fa fa-external-link" aria-hidden="true"></i><span class="sr-only">Sitede görüntüle: @item.Baslik</span></a>
                            <a class="kp-row-action" href="/Blog/Edit/@item.BlogId"><i class="fa fa-pencil" aria-hidden="true"></i> Düzenle</a>
                            <a class="kp-row-action kp-row-action-danger" href="/Blog/Delete/@item.BlogId"><i class="fa fa-trash-o" aria-hidden="true"></i> Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

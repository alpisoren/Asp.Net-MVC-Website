@using CorporateWebsite.Helper;
@model IPagedList<CorporateWebsite.Models.Model.Blog>
@{
    Layout = "~/Views/Shared/_SiteLayout.cshtml";
    string kategoriAd = ViewBag.KategoriAd;
    string kategoriUrl = Context.Request.Path.Value;
    ViewBag.Title = kategoriAd + " yazıları";
    ViewBag.SayfaBasligi = kategoriAd;
    ViewBag.UstSayfaAd = "Blog";
    ViewBag.UstSayfaUrl = "/BlogPost";
    // Önceden sayfalama bağlantıları yanlışlıkla genel blog listesine gidiyordu; artık kategori içinde kalır.
    ViewData["SayfaUrl"] = (Func<int, string>)(p => p > 1 ? kategoriUrl + "?Page=" + p : kategoriUrl);
}
@await Html.PartialAsync("_BlogListesi", Model)

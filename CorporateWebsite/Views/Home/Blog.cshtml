@using PagedList;
@model IPagedList<CorporateWebsite.Models.Model.Blog>
@{
    Layout = "~/Views/Shared/_SiteLayout.cshtml";
    ViewBag.Title = Model.PageNumber > 1 ? "Blog - Sayfa " + Model.PageNumber : "Blog";
    ViewBag.SayfaBasligi = "Blog";
    ViewData["SayfaUrl"] = (Func<int, string>)(p => p > 1 ? "/BlogPost?Page=" + p : "/BlogPost");
}
@Html.Partial("_BlogListesi", Model)

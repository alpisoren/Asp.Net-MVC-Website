@model CorporateWebsite.Models.Model.Iletisim
@{
    Layout = "~/Views/Shared/_SiteLayout.cshtml";
    ViewBag.Title = "İletişim";
    ViewBag.SayfaBasligi = "İletişim";
    ViewBag.CtaGizle = true; // bu sayfada "iletişime geçin" şeridine gerek yok

    string eposta = Model?.Eposta;
    string telefon = Model?.Telefon;
    string telefonLink = string.IsNullOrEmpty(telefon) ? null : "tel:" + System.Text.RegularExpressions.Regex.Replace(telefon, @"[^\d+]", "");
    string haritaUrl = string.IsNullOrWhiteSpace(Model?.Adres) ? null
        : "https://www.google.com/maps?q=" + Uri.EscapeDataString(Model.Adres) + "&output=embed";

    string uyari = ViewBag.Uyari;
    bool uyariBasarili = ViewBag.UyariBasarili == true;
}

<section class="kw-section">
    <div class="container">
        <div class="row g-4 g-lg-5">

            <div class="col-lg-5">
                <span class="kw-eyebrow">Bize ulaşın</span>
                <h2 class="mb-3">Size nasıl yardımcı olabiliriz?</h2>
                <p class="text-secondary mb-4">Formu doldurun, en kısa sürede size dönüş yapalım. Dilerseniz doğrudan arayabilir ya da e-posta gönderebilirsiniz.</p>

                @if (!string.IsNullOrEmpty(Model?.Adres))
                {
                    <div class="kw-contact-item">
                        <span class="kw-contact-icon" aria-hidden="true"><i class="bi bi-geo-alt"></i></span>
                        <div><h3>Adres</h3><p>@Model.Adres</p></div>
                    </div>
                }
                @if (telefonLink != null)
                {
                    <div class="kw-contact-item">
                        <span class="kw-contact-icon" aria-hidden="true"><i class="bi bi-telephone"></i></span>
                        <div><h3>Telefon</h3><p><a href="@telefonLink">@telefon</a></p></div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(eposta))
                {
                    <div class="kw-contact-item">
                        <span class="kw-contact-icon" aria-hidden="true"><i class="bi bi-envelope"></i></span>
                        <div><h3>E-posta</h3><p><a href="mailto:@eposta">@eposta</a></p></div>
                    </div>
                }
            </div>

            <div class="col-lg-7">
                <div class="kw-sidebar-box p-4 p-md-5">
                    <h2 class="h4 mb-4" id="form-baslik">Mesaj gönderin</h2>
                    <form id="iletisimFormu" class="kw-form" action="/Home/Iletisim" method="post" aria-labelledby="form-baslik">
                        @Html.AntiForgeryToken()
                        <div class="visually-hidden" aria-hidden="true"><label for="website">Bu alanı boş bırakın</label><input type="text" id="website" name="website" tabindex="-1" autocomplete="off"></div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="name">Adınız Soyadınız <span class="kw-required" aria-hidden="true">*</span></label>
                                <input type="text" name="name" class="form-control" id="name" required maxlength="100" autocomplete="name">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="email">E-posta <span class="kw-required" aria-hidden="true">*</span></label>
                                <input type="email" class="form-control" name="email" id="email" required maxlength="100" autocomplete="email">
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="subject">Konu <span class="kw-required" aria-hidden="true">*</span></label>
                                <input type="text" class="form-control" name="subject" id="subject" required maxlength="200">
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="message">Mesajınız <span class="kw-required" aria-hidden="true">*</span></label>
                                <textarea class="form-control" name="message" id="message" rows="6" required maxlength="5000"></textarea>
                            </div>
                            <div class="col-12">
                                <div id="iletisimDurum" role="status" aria-live="polite" class="kw-alert @(uyari != null ? "is-visible " + (uyariBasarili ? "kw-alert-success" : "kw-alert-error") : null)">@uyari</div>
                            </div>
                            <div class="col-12 d-flex flex-wrap align-items-center justify-content-between gap-2">
                                <span class="kw-form-note"><span aria-hidden="true">*</span> Zorunlu alanlar</span>
                                <button type="submit" class="kw-btn kw-btn-primary">Gönder <i class="bi bi-send" aria-hidden="true"></i></button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        @if (haritaUrl != null)
        {
            <div class="mt-5">
                <iframe class="kw-map" src="@haritaUrl" title="Adresimiz haritada: @Model.Adres" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
        }
    </div>
</section>

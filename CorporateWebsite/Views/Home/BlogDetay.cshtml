@model CorporateWebsite.Models.Model.Blog
@using CorporateWebsite.Helper;
@{
    Layout = "~/Views/Shared/_SiteLayout.cshtml";
    ViewBag.Title = Model.Baslik;
    ViewBag.SayfaBasligi = Model.Baslik;
    ViewBag.KonumAd = "Yazı";
    ViewBag.UstSayfaAd = "Blog";
    ViewBag.UstSayfaUrl = "/BlogPost";
    var yorumlar = Model.Yorumlar.Where(y => y.Onayli).OrderByDescending(x => x.YorumId).ToList();
}

<section class="kw-section">
    <div class="container">
        <div class="row g-4 g-lg-5">
            <div class="col-lg-8">
                <article>
                    @if (Model.Kategori != null)
                    {
                        <div class="kw-article-meta">
                            <a class="kw-badge" href="@SeoHelper.KategoriUrl(Model.Kategori.KategoriAd, Model.Kategori.KategoriId)"><i class="bi bi-folder2" aria-hidden="true"></i> @Model.Kategori.KategoriAd</a>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.ResimURL))
                    {
                        <figure class="kw-article-cover">
                            <img src="@Model.ResimURL" alt="" width="1200" height="675">
                        </figure>
                    }

                    <div class="kw-prose">
                        @Html.Raw(HtmlTemizleyici.Temizle(Model.Icerik))
                    </div>
                </article>

                <section class="kw-comments" aria-labelledby="yorumlar-baslik">
                    <h2 id="yorumlar-baslik">Yorumlar (@yorumlar.Count)</h2>

                    @if (yorumlar.Count == 0)
                    {
                        <p class="kw-form-note">Henüz yorum yok. İlk yorumu siz yazın.</p>
                    }
                    else
                    {
                        foreach (var y in yorumlar)
                        {
                            <div class="kw-comment">
                                <span class="kw-avatar" aria-hidden="true">@(string.IsNullOrEmpty(y.AdSoyad) ? "?" : y.AdSoyad.Substring(0, 1).ToUpper())</span>
                                <div>
                                    <p class="kw-comment-name">@y.AdSoyad</p>
                                    <p class="kw-comment-text">@y.Icerik</p>
                                </div>
                            </div>
                        }
                    }

                    <div class="kw-sidebar-box mt-4">
                        <h2 class="h5" id="yorum-yap-baslik">Yorum yazın</h2>
                        <p class="kw-form-note">E-posta adresiniz yayınlanmaz. Yorumlar onaylandıktan sonra görünür.</p>
                        <form id="yorumFormu" class="kw-form" action="/Home/YorumYap" method="post" aria-labelledby="yorum-yap-baslik">
                            <input type="hidden" name="blogId" value="@Model.BlogId" />
                            @Html.AntiForgeryToken()
                            <div class="visually-hidden" aria-hidden="true"><label for="website">Bu alanı boş bırakın</label><input type="text" name="website" id="website" tabindex="-1" autocomplete="off" /></div>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label" for="adsoyad">Adınız Soyadınız <span class="kw-required" aria-hidden="true">*</span></label>
                                    <input type="text" name="adsoyad" id="adsoyad" class="form-control" required maxlength="50" autocomplete="name" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="eposta">E-posta <span class="kw-required" aria-hidden="true">*</span></label>
                                    <input type="email" name="eposta" id="eposta" class="form-control" required maxlength="100" autocomplete="email" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="icerik">Yorumunuz <span class="kw-required" aria-hidden="true">*</span></label>
                                    <textarea name="icerik" id="icerik" class="form-control" required maxlength="2000" rows="5"></textarea>
                                </div>
                                <div class="col-12">
                                    <div id="yorumDurum" class="kw-alert mb-3" role="status" aria-live="polite"></div>
                                    <button type="submit" class="kw-btn kw-btn-primary">Yorumu Gönder</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </section>
            </div>

            <div class="col-lg-4">
                @Html.Partial("_BlogKenarCubugu")
            </div>
        </div>
    </div>
</section>

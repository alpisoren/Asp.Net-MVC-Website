@model IEnumerable<CorporateWebsite.Models.Model.Hizmet>
@using CorporateWebsite.Helper;
@{
    Layout = "~/Views/Shared/_SiteLayout.cshtml";
    ViewBag.Title = "Hizmetlerimiz";
    ViewBag.SayfaBasligi = "Hizmetlerimiz";
}

<section class="kw-section">
    <div class="container">
        @if (!Model.Any())
        {
            <div class="kw-empty">
                <i class="bi bi-briefcase" aria-hidden="true"></i>
                Hizmetlerimiz yakında burada olacak. Bilgi almak için <a href="/Iletisim">bize ulaşın</a>.
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var item in Model)
                {
                    <div class="col-md-6 col-lg-4" data-aos="fade-up">
                        <article class="kw-card">
                            @if (!string.IsNullOrEmpty(item.ResimUrl))
                            {
                                <div class="kw-card-media">
                                    <img src="@item.ResimUrl" alt="" loading="lazy" width="500" height="281">
                                </div>
                            }
                            <div class="kw-card-body">
                                @if (string.IsNullOrEmpty(item.ResimUrl))
                                {
                                    <div class="kw-service-icon" aria-hidden="true"><i class="bi bi-briefcase"></i></div>
                                }
                                <h2 class="h5">@item.Baslik</h2>
                                <div class="kw-card-text kw-prose">@Html.Raw(HtmlTemizleyici.Temizle(item.Aciklama))</div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </div>
</section>

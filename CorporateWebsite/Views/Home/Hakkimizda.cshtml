@model CorporateWebsite.Models.Model.Hakkimizda
@using CorporateWebsite.Helper;
@{
    Layout = "~/Views/Shared/_SiteLayout.cshtml";
    ViewBag.Title = "Hakkımızda";
    ViewBag.SayfaBasligi = "Hakkımızda";
    string unvan = ViewBag.Kimlik?.Unvan ?? "Ekibimiz";
}

<section class="kw-section">
    <div class="container">
        <div class="row g-4 g-lg-5 align-items-start">
            <div class="col-lg-5">
                <div class="kw-about-media">
                    <img src="~/Content/SiteLayout/assets/img/why-us.jpg" alt="@unvan ekibi ofiste birlikte çalışırken" width="640" height="480">
                </div>
            </div>
            <div class="col-lg-7">
                @if (string.IsNullOrWhiteSpace(Model?.Aciklama))
                {
                    <div class="kw-empty">
                        <i class="bi bi-building" aria-hidden="true"></i>
                        Kurumsal tanıtım metnimiz hazırlanıyor.
                    </div>
                }
                else
                {
                    <div class="kw-prose">
                        @Html.Raw(HtmlTemizleyici.Temizle(Model.Aciklama))
                    </div>
                }
                <div class="d-flex flex-wrap gap-2 mt-4">
                    <a class="kw-btn kw-btn-primary" href="/Iletisim">Bizimle Çalışın <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                    @* Abonelik düğmesi (Chargebee checkout öznitelikleri korunuyor) *@
                    <a href="#" class="kw-btn kw-btn-outline" data-cb-type="checkout" data-cb-plan-id="comics-box">Abone Ol</a>
                </div>
            </div>
        </div>
    </div>
</section>

@model IEnumerable<CorporateWebsite.Models.Model.Blog>
@using CorporateWebsite.Helper;
<section class="kw-sidebar-box" aria-labelledby="son-gonderiler-baslik">
    <h2 id="son-gonderiler-baslik">Son Gönderiler</h2>
    @if (!Model.Any())
    {
        <p class="kw-form-note mb-0">Henüz yazı yok.</p>
    }
    else
    {
        <ul class="kw-sidebar-list">
            @foreach (var item in Model)
            {
                <li><a href="@SeoHelper.BlogUrl(item.Baslik, item.BlogId)"><span>@item.Baslik</span></a></li>
            }
        </ul>
    }
</section>

@model CorporateWebsite.Models.ViewModel.HizmetFormModeli
@{
    ViewBag.Title = "Hizmeti Düzenle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}


<div class="form">
    <form class="form-validate form-horizontal" id="feedback_form" method="post" action="/Hizmet/Edit/@Model.HizmetId" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(false, "", new { @class = "text-danger" })
        <div class="form-group ">
            <label for="cname" class="control-label col-lg-2">Başlık<span class="required">*</span></label>
            <div class="col-lg-10">
                <input class="form-control" id="Baslik" name="Baslik" maxlength="150" type="text" required value="@Model.Baslik" />
            </div>
        </div>
        <div class="form-group ">
            <label for="cemail" class="control-label col-lg-2">Açıklama <span class="required">*</span></label>
            <div class="col-lg-10">
                <textarea name="Aciklama" id="Aciklama" class="form-control kp-zengin-editor">@Model.Aciklama</textarea>
            </div>
        </div>
        <div class="form-group ">
            <label for="curl" class="control-label col-lg-2">Önceki Resim</label>
            <div class="col-lg-10">
                <img src="@Model.ResimUrl" height="150" width="150" alt="" /> </div>
        </div>
        <div class="form-group ">
            <label for="curl" class="control-label col-lg-2">Yeni Resim</label>
            <div class="col-lg-10">
                <input class="form-control" id="ResimUrl" type="file" name="ResimUrl" accept=".jpg,.png,.jpeg" />
            </div>
        </div>

        <div class="form-group">
            <div class="col-lg-offset-2 col-lg-10">
                <button type="submit" class="btn btn-primary"><i class="fa fa-check" aria-hidden="true"></i>Kaydet</button>
                <a class="btn btn-default" href="/Hizmet/Index">Vazgeç</a>
            </div>
        </div>

    </form>
</div>
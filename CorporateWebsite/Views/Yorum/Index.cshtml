@model IEnumerable<CorporateWebsite.Models.Model.Yorum>
@{
    ViewBag.Title = "Yorumlar";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@if (!Model.Any())
{
    <div class="kp-empty"><i class="fa fa-comments-o" aria-hidden="true"></i><p>Henüz yorum yok.</p></div>
}
else
{
    <p class="kp-muted">Ziyaretçi yorumları siz onaylayana kadar sitede görünmez. Onay bekleyenler listenin başında.</p>
    <div class="table-responsive">
        <table class="table kp-table" data-tablo>
            <thead>
                <tr>
                    <th scope="col">Durum</th>
                    <th scope="col">Yazan</th>
                    <th scope="col">Yorum</th>
                    <th scope="col">Yazı</th>
                    <th scope="col"><span class="sr-only">İşlemler</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td data-order="@(item.Onayli ? 1 : 0)">
                            @if (item.Onayli)
                            {<span class="kp-status kp-status-ok"><i class="fa fa-check" aria-hidden="true"></i> Yayında</span>}
                            else
                            {<span class="kp-status kp-status-wait"><i class="fa fa-clock-o" aria-hidden="true"></i> Bekliyor</span>}
                        </td>
                        <td>
                            <strong>@item.AdSoyad</strong>
                            @if (!string.IsNullOrEmpty(item.Eposta))
                            {<br /><small class="kp-muted">@item.Eposta</small>}
                        </td>
                        <td><span class="kp-clamp">@item.Icerik</span></td>
                        <td><span class="kp-clamp">@(item.Blog?.Baslik ?? "—")</span></td>
                        <td>
                            @using (Html.BeginForm("OnayDegistir", "Yorum", new { id = item.YorumId }, FormMethod.Post, new { @class = "kp-inline" }))
                            {
                                @Html.AntiForgeryToken()
                                if (item.Onayli)
                                {
                                    <button type="submit" class="kp-row-action"><i class="fa fa-eye-slash" aria-hidden="true"></i> Yayından kaldır</button>
                                }
                                else
                                {
                                    <button type="submit" class="kp-row-action"><i class="fa fa-check" aria-hidden="true"></i> Onayla</button>
                                }
                            }
                            <a class="kp-row-action" href="/Yorum/Edit/@item.YorumId"><i class="fa fa-pencil" aria-hidden="true"></i> Düzenle</a>
                            <a class="kp-row-action kp-row-action-danger" href="/Yorum/Delete/@item.YorumId"><i class="fa fa-trash-o" aria-hidden="true"></i> Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@{
    Layout = "~/Views/Shared/_SiteLayout.cshtml";
    ViewBag.Title = "Hata";
    ViewBag.SayfaBasligi = "Bir sorun oluştu";
    ViewBag.CtaGizle = true;
}
<section class="kw-section">
    <div class="container">
        <div class="kw-hata-kutusu">
            <p class="kw-hata-kod" aria-hidden="true">@ViewBag.Kod</p>
            <p class="lead">@ViewBag.Mesaj</p>
            <nav aria-label="Önerilen sayfalar">
                <ul class="kw-hata-baglantilar">
                    <li><a class="kw-btn kw-btn-primary" href="/"><i class="bi bi-house" aria-hidden="true"></i> Ana Sayfa</a></li>
                    <li><a class="kw-btn kw-btn-outline" href="/Iletisim">İletişim</a></li>
                </ul>
            </nav>
        </div>
    </div>
</section>

@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewBag.Title = "Giriş Yap";
}

<h1>Giriş yapın</h1>
<p class="kp-sub">Yönetim paneline erişmek için hesap bilgilerinizi girin.</p>

@if (ViewBag.Uyari != null)
{
    <div class="alert alert-danger" role="alert">@ViewBag.Uyari</div>
}

<form method="post" action="/Admin/Login">
    @Html.AntiForgeryToken()
    <div class="form-group">
        <label for="Eposta">E-posta</label>
        <input type="email" class="form-control" id="Eposta" name="Eposta" autocomplete="username" required autofocus>
    </div>
    <div class="form-group">
        <label for="Sifre">Şifre</label>
        <input type="password" class="form-control" id="Sifre" name="Sifre" autocomplete="current-password" required>
    </div>
    <button class="btn btn-primary btn-block" type="submit">Giriş Yap</button>
</form>

<div class="kp-auth-links">
    <a href="/Admin/ResetPassword/">Şifremi unuttum</a>
</div>

@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewBag.Title = "Şifremi Unuttum";
}

<h1>Şifremi unuttum</h1>
<p class="kp-sub">Hesabınıza kayıtlı e-posta adresini girin; şifre sıfırlama bağlantısı gönderelim.</p>

@if (ViewBag.Uyari != null)
{
    <div class="alert alert-info" role="status">@ViewBag.Uyari</div>
}

@using (Html.BeginForm("ResetPassword", "Admin", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <div class="form-group">
        <label for="eposta">E-posta</label>
        <input type="email" class="form-control" id="eposta" name="eposta" autocomplete="email" required autofocus>
    </div>
    <button type="submit" class="btn btn-primary btn-block">Sıfırlama Bağlantısı Gönder</button>
}

<div class="kp-auth-links">
    <a href="/yonetimpaneli/giris"><i class="fa fa-angle-left" aria-hidden="true"></i> Girişe dön</a>
</div>

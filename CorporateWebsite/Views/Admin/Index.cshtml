@model IEnumerable<CorporateWebsite.Models.Model.Kategori>
@{
    ViewBag.Title = "Özet";
    ViewBag.KartsizIcerik = true;
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var bekleyenler = (IList<CorporateWebsite.Models.Model.Yorum>)ViewBag.BekleyenYorumlar;
    bool adminMi = CorporateWebsite.Helper.YoneticiOturumu.Aktif(Context)?.AdminMi == true;
}

<div class="kp-stats">
    <a class="kp-stat" href="/Blog/Index">
        <span class="kp-stat-icon" aria-hidden="true"><i class="fa fa-file-text-o"></i></span>
        <span><span class="kp-stat-value">@ViewBag.BlogSay</span><span class="kp-stat-label">Blog yazısı</span></span>
    </a>
    <a class="kp-stat" href="/Kategori/Index">
        <span class="kp-stat-icon" aria-hidden="true"><i class="fa fa-folder-o"></i></span>
        <span><span class="kp-stat-value">@ViewBag.KategoriSay</span><span class="kp-stat-label">Kategori</span></span>
    </a>
    <a class="kp-stat" href="/Hizmet/Index">
        <span class="kp-stat-icon" aria-hidden="true"><i class="fa fa-briefcase"></i></span>
        <span><span class="kp-stat-value">@ViewBag.HizmetSay</span><span class="kp-stat-label">Hizmet</span></span>
    </a>
    <a class="kp-stat" href="/Yorum/Index">
        <span class="kp-stat-icon @(bekleyenler.Count > 0 ? "is-warn" : null)" aria-hidden="true"><i class="fa fa-comments-o"></i></span>
        <span>
            <span class="kp-stat-value">@ViewBag.YorumSay</span>
            <span class="kp-stat-label">Yorum @(bekleyenler.Count > 0 ? "· " + bekleyenler.Count + (bekleyenler.Count == 5 ? "+" : "") + " onay bekliyor" : "")</span>
        </span>
    </a>
</div>

<div class="row">
    <div class="col-lg-7">
        <section class="kp-card" aria-labelledby="bekleyen-baslik">
            <h2 class="kp-card-title" id="bekleyen-baslik">Onay bekleyen yorumlar</h2>
            @if (bekleyenler.Count == 0)
            {
                <p class="kp-muted"><i class="fa fa-check-circle" aria-hidden="true"></i> Onay bekleyen yorum yok.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table kp-table">
                        <thead>
                            <tr><th scope="col">Yazan</th><th scope="col">Yorum</th><th scope="col">Yazı</th><th scope="col"><span class="sr-only">İşlem</span></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var y in bekleyenler)
                            {
                                <tr>
                                    <td>@y.AdSoyad</td>
                                    <td><span class="kp-clamp">@y.Icerik</span></td>
                                    <td><span class="kp-clamp">@(y.Blog?.Baslik)</span></td>
                                    <td>
                                        @using (Html.BeginForm("OnayDegistir", "Yorum", new { id = y.YorumId, donus = "/yonetimpaneli" }, FormMethod.Post, null, new { @class = "kp-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="kp-row-action"><i class="fa fa-check" aria-hidden="true"></i> Onayla</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="kp-back"><a href="/Yorum/Index">Tüm yorumlar <i class="fa fa-angle-right" aria-hidden="true"></i></a></p>
            }
        </section>
    </div>

    <div class="col-lg-5">
        <section class="kp-card" aria-labelledby="hizli-baslik">
            <h2 class="kp-card-title" id="hizli-baslik">Hızlı işlemler</h2>
            <div class="kp-quick">
                <a href="/Blog/Create"><i class="fa fa-pencil" aria-hidden="true"></i> Yeni blog yazısı</a>
                <a href="/Hizmet/Create"><i class="fa fa-plus-square-o" aria-hidden="true"></i> Yeni hizmet</a>
                <a href="/Kategori/Create"><i class="fa fa-folder-open-o" aria-hidden="true"></i> Yeni kategori</a>
                @if (adminMi)
                {
                    <a href="/Slider/Create"><i class="fa fa-picture-o" aria-hidden="true"></i> Slider ekle</a>
                    <a href="/Kimlik/Index"><i class="fa fa-id-card-o" aria-hidden="true"></i> Site kimliği</a>
                }
                <a href="/" target="_blank" rel="noopener"><i class="fa fa-external-link" aria-hidden="true"></i> Siteyi görüntüle</a>
            </div>
        </section>
    </div>
</div>

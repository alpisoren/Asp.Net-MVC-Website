@using CorporateWebsite.Helper;
@{
    var kimlik = ViewBag.Kimlik;
    var iletisim = ViewBag.Iletisim;
    string unvan = kimlik?.Unvan ?? kimlik?.Title ?? "Kurumsal";
    string logo = kimlik?.LogoUrl;

    // Menüde bulunduğumuz sayfayı işaretle
    var aksiyon = (ViewContext.RouteData.Values["action"] as string) ?? "";
    string aktif;
    switch (aksiyon)
    {
        case "Hakkimizda": aktif = "hakkimizda"; break;
        case "Hizmetlerimiz": aktif = "hizmetler"; break;
        case "Blog":
        case "BlogDetay":
        case "KategoriBlog": aktif = "blog"; break;
        case "Iletisim": aktif = "iletisim"; break;
        case "Bulunamadi":
        case "CerezPolitikasi": aktif = ""; break;
        default: aktif = "anasayfa"; break;
    }
    Func<string, string> aktifSinif = k => k == aktif ? "active" : null;
    Func<string, string> aktifAria = k => k == aktif ? "page" : null;

    string sayfaBasligi = ViewBag.SayfaBasligi;
    string baslik = ViewBag.Title as string;
    string tamBaslik = string.IsNullOrEmpty(baslik) ? (kimlik?.Title ?? unvan) : baslik + " | " + (kimlik?.Title ?? unvan);
    ViewBag.TamBaslik = tamBaslik;

    string eposta = iletisim?.Eposta;
    string telefon = iletisim?.Telefon;
    string telefonLink = string.IsNullOrEmpty(telefon) ? null : "tel:" + System.Text.RegularExpressions.Regex.Replace(telefon, @"[^\d+]", "");
    string analitikKimligi = CorporateWebsite.Filters.GuvenlikBasliklariAttribute.AnalitikKimligi;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@tamBaslik</title>
    @await Html.PartialAsync("_SeoEtiketleri")
    @if (!string.IsNullOrEmpty(Ayarlar.Site.GoogleSiteDogrulama))
    {
        <meta name="google-site-verification" content="@Ayarlar.Site.GoogleSiteDogrulama">
    }
    <link rel="alternate" type="application/rss+xml" title="@(kimlik?.Title ?? unvan) — Blog" href="/rss.xml">
    <meta name="theme-color" content="#F6F8FB">
    <meta name="color-scheme" content="light dark">

    <link href="/Content/SiteLayout/assets/img/favicon.png" rel="icon">
    <link href="/Content/SiteLayout/assets/img/apple-touch-icon.png" rel="apple-touch-icon">

    <!-- Yazı tipleri (başlık Poppins, metin Open Sans) sitenin kendi sunucusundan; en çok kullanılan ikisi önceden yüklenir -->
    <link rel="preload" href="/Content/SiteLayout/fonts/open-sans-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/Content/SiteLayout/fonts/poppins-600-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link href="~/Content/SiteLayout/fonts/fonts.css" asp-append-version="true" rel="stylesheet">

    <link href="~/Content/SiteLayout/assets/vendor/aos/aos.css" asp-append-version="true" rel="stylesheet">
    <link href="~/Content/SiteLayout/assets/vendor/bootstrap/css/bootstrap.min.css" asp-append-version="true" rel="stylesheet">
    <link href="~/Content/SiteLayout/assets/vendor/bootstrap-icons/bootstrap-icons.css" asp-append-version="true" rel="stylesheet">

    <!-- Şablon + kurumsal tema (tema.css şablonun üzerine yazar) -->
    <link href="~/Content/SiteLayout/assets/css/style.css" asp-append-version="true" rel="stylesheet">
    <link href="~/Content/SiteLayout/css/tema.css" asp-append-version="true" rel="stylesheet">
    <!-- Açık/koyu tema: sayfa çizilmeden uygulanır (defer YOK) -->
    <script src="~/Content/tema-gecis.js" asp-append-version="true"></script>
</head>
<body>
    <a class="kw-skip-link" href="#main">İçeriğe geç</a>

    <header id="header" class="fixed-top d-flex align-items-center">
        <div class="container d-flex justify-content-between align-items-center">

            <div class="logo">
                <p class="kw-logo-baslik">
                    <a href="/">
                        @if (!string.IsNullOrEmpty(logo))
                        {
                            <img src="@logo" alt="" width="40" height="40">
                        }
                        <span>@unvan</span>
                    </a>
                </p>
            </div>

            <div class="kw-header-actions">
            <nav id="navbar" class="navbar" aria-label="Ana menü">
                <ul>
                    <li><a class="@aktifSinif("anasayfa")" aria-current="@aktifAria("anasayfa")" href="/">Ana Sayfa</a></li>
                    <li><a class="@aktifSinif("hakkimizda")" aria-current="@aktifAria("hakkimizda")" href="/Hakkimizda">Hakkımızda</a></li>
                    <li><a class="@aktifSinif("hizmetler")" aria-current="@aktifAria("hizmetler")" href="/Hizmetlerimiz">Hizmetlerimiz</a></li>
                    <li><a class="@aktifSinif("blog")" aria-current="@aktifAria("blog")" href="/BlogPost">Blog</a></li>
                    <li><a class="@aktifSinif("iletisim")" aria-current="@aktifAria("iletisim")" href="/Iletisim">İletişim</a></li>
                </ul>
                <button type="button" class="bi bi-list mobile-nav-toggle" aria-label="Menüyü aç/kapat" aria-controls="navbar"></button>
            </nav>
            <button type="button" class="kw-theme-toggle" data-tema-degistir aria-pressed="false" aria-label="Koyu temaya geç" title="Koyu temaya geç">
                <i class="bi bi-moon-stars kw-icon-light" aria-hidden="true"></i>
                <i class="bi bi-sun kw-icon-dark" aria-hidden="true"></i>
            </button>
            </div>

        </div>
    </header>

    <main id="main" tabindex="-1">
        @if (!string.IsNullOrEmpty(sayfaBasligi))
        {
            <section class="kw-page-header">
                <div class="container">
                    <h1>@sayfaBasligi</h1>
                    <nav aria-label="Konum">
                        <ol class="kw-breadcrumb">
                            <li><a href="/">Ana Sayfa</a></li>
                            @if (ViewBag.UstSayfaAd != null)
                            {
                                <li><a href="@ViewBag.UstSayfaUrl">@ViewBag.UstSayfaAd</a></li>
                            }
                            <li aria-current="page">@(ViewBag.KonumAd ?? sayfaBasligi)</li>
                        </ol>
                    </nav>
                </div>
            </section>
        }

        @RenderBody()

        @if (ViewBag.CtaGizle != true)
        {
            <section class="kw-cta" aria-labelledby="cta-baslik">
                <div class="container d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
                    <div>
                        <h2 id="cta-baslik">Projeniz için bizimle görüşün</h2>
                        <p>İhtiyacınızı dinleyelim, size en uygun çözümü birlikte planlayalım.</p>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <a class="kw-btn kw-btn-light" href="/Iletisim"><i class="bi bi-envelope" aria-hidden="true"></i> İletişime Geçin</a>
                        @if (telefonLink != null)
                        {
                            <a class="kw-btn kw-btn-ghost-light" href="@telefonLink"><i class="bi bi-telephone" aria-hidden="true"></i> @telefon</a>
                        }
                    </div>
                </div>
            </section>
        }
    </main>

    <footer id="footer">
        <div class="footer-top">
            <div class="container">
                <div class="row gy-4">

                    <div class="col-lg-4 col-md-6">
                        <h2>@unvan</h2>
                        @if (!string.IsNullOrEmpty((string)kimlik?.Description))
                        {
                            <p>@kimlik.Description</p>
                        }
                        <div class="social-links mt-3">
                            @if (!string.IsNullOrEmpty((string)iletisim?.Twitter))
                            {
                                <a href="https://twitter.com/@iletisim.Twitter" aria-label="X (Twitter)" rel="noopener" target="_blank"><i class="bi bi-twitter-x" aria-hidden="true"></i></a>
                            }
                            @if (!string.IsNullOrEmpty((string)iletisim?.Facebook))
                            {
                                <a href="https://www.facebook.com/@iletisim.Facebook" aria-label="Facebook" rel="noopener" target="_blank"><i class="bi bi-facebook" aria-hidden="true"></i></a>
                            }
                            @if (!string.IsNullOrEmpty((string)iletisim?.Instagram))
                            {
                                <a href="https://www.instagram.com/@iletisim.Instagram" aria-label="Instagram" rel="noopener" target="_blank"><i class="bi bi-instagram" aria-hidden="true"></i></a>
                            }
                        </div>
                    </div>

                    <div class="col-lg-2 col-md-6 footer-links">
                        <h2>Menü</h2>
                        <ul>
                            <li><i class="bi bi-chevron-right" aria-hidden="true"></i> <a href="/">Ana Sayfa</a></li>
                            <li><i class="bi bi-chevron-right" aria-hidden="true"></i> <a href="/Hakkimizda">Hakkımızda</a></li>
                            <li><i class="bi bi-chevron-right" aria-hidden="true"></i> <a href="/Hizmetlerimiz">Hizmetlerimiz</a></li>
                            <li><i class="bi bi-chevron-right" aria-hidden="true"></i> <a href="/BlogPost">Blog</a></li>
                            <li><i class="bi bi-chevron-right" aria-hidden="true"></i> <a href="/Iletisim">İletişim</a></li>
                        </ul>
                    </div>

                    <div class="col-lg-3 col-md-6 footer-links">
                        <h2>Son Yazılar</h2>
                        <ul>
                            @foreach (var item in ViewBag.Blog ?? new List<CorporateWebsite.Models.Model.Blog>())
                            {
                                <li><i class="bi bi-chevron-right" aria-hidden="true"></i> <a href="@SeoHelper.BlogUrl(item.Baslik, item.BlogId)">@item.Baslik</a></li>
                            }
                        </ul>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <h2>İletişim</h2>
                        <address class="mb-0">
                            @if (!string.IsNullOrEmpty((string)iletisim?.Adres))
                            {
                                <p class="mb-2"><i class="bi bi-geo-alt me-2" aria-hidden="true"></i>@iletisim.Adres</p>
                            }
                            @if (telefonLink != null)
                            {
                                <p class="mb-2"><i class="bi bi-telephone me-2" aria-hidden="true"></i><a href="@telefonLink">@telefon</a></p>
                            }
                            @if (!string.IsNullOrEmpty(eposta))
                            {
                                <p class="mb-2"><i class="bi bi-envelope me-2" aria-hidden="true"></i><a href="mailto:@eposta">@eposta</a></p>
                            }
                        </address>
                    </div>

                </div>
            </div>
        </div>

        <div class="container">
            <div class="copyright">
                <p>&copy; @DateTime.Now.Year @unvan.TrimEnd('.'). Tüm hakları saklıdır.</p>
                <p class="kw-yasal">
                    <a href="/cerez-politikasi">Çerez Politikası</a>
                    @if (analitikKimligi != null)
                    {
                        <span aria-hidden="true">·</span>
                        <a href="#kw-cerez" data-cerez-ayar>Çerez tercihleri</a>
                    }
                </p>
            </div>
        </div>
    </footer>

    @if (analitikKimligi != null)
    {
        <div id="kw-cerez" class="kw-cerez" role="region" aria-label="Çerez tercihi" data-ga="@analitikKimligi" hidden>
            <p>
                Siteyi nasıl kullandığınızı anlamak için, onay verirseniz Google Analytics çerezlerini kullanırız.
                Reklam amaçlı çerez kullanmıyoruz. <a href="/cerez-politikasi">Ayrıntılar</a>
            </p>
            <div class="kw-cerez-dugmeler">
                <button type="button" class="kw-btn kw-btn-outline" data-cerez="ret">Reddet</button>
                <button type="button" class="kw-btn kw-btn-primary" data-cerez="kabul">Kabul et</button>
            </div>
        </div>
    }

    <a href="#" class="back-to-top d-flex align-items-center justify-content-center" aria-label="Sayfanın başına dön"><i class="bi bi-arrow-up-short" aria-hidden="true"></i></a>

    <script defer src="~/Content/SiteLayout/assets/vendor/aos/aos.js" asp-append-version="true"></script>
    <script defer src="~/Content/SiteLayout/assets/vendor/bootstrap/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script defer src="~/Content/SiteLayout/js/site.js" asp-append-version="true"></script>
    <script defer src="~/Scripts/jquery-3.7.1.min.js" asp-append-version="true"></script>
    <script defer src="~/Content/SiteLayout/js/yorum.js" asp-append-version="true"></script>
    <script defer src="~/Content/SiteLayout/js/iletisim.js" asp-append-version="true"></script>
    @if (analitikKimligi != null)
    {
        <script defer src="~/Content/SiteLayout/js/analitik.js" asp-append-version="true"></script>
    }
</body>
</html>

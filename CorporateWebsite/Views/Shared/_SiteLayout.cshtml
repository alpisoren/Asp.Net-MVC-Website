@using CorporateWebsite.Helper;
@{
    var kimlik = ViewBag.Kimlik;
    var iletisim = ViewBag.Iletisim;
    string unvan = kimlik?.Unvan ?? kimlik?.Title ?? "Kurumsal";
    string logo = kimlik?.LogoUrl;

    // Menüde bulunduğumuz sayfayı işaretle
    var aksiyon = (ViewContext.Controller.ControllerContext.RouteData.Values["action"] as string) ?? "";
    string aktif;
    switch (aksiyon)
    {
        case "Hakkimizda": aktif = "hakkimizda"; break;
        case "Hizmetlerimiz": aktif = "hizmetler"; break;
        case "Blog":
        case "BlogDetay":
        case "KategoriBlog": aktif = "blog"; break;
        case "Iletisim": aktif = "iletisim"; break;
        default: aktif = "anasayfa"; break;
    }
    Func<string, string> aktifSinif = k => k == aktif ? "active" : null;
    Func<string, string> aktifAria = k => k == aktif ? "page" : null;

    string sayfaBasligi = ViewBag.SayfaBasligi;
    string baslik = ViewBag.Title as string;
    string tamBaslik = string.IsNullOrEmpty(baslik) ? (kimlik?.Title ?? unvan) : baslik + " | " + (kimlik?.Title ?? unvan);

    string eposta = iletisim?.Fax;      // İletişim tablosunda e-posta tarihsel olarak "Fax" alanında tutuluyor
    string telefon = iletisim?.Telefon;
    string telefonLink = string.IsNullOrEmpty(telefon) ? null : "tel:" + System.Text.RegularExpressions.Regex.Replace(telefon, @"[^\d+]", "");
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@tamBaslik</title>
    <meta name="description" content="@(ViewBag.Aciklama ?? kimlik?.Description)">
    @if (!string.IsNullOrEmpty((string)kimlik?.Keywords))
    {
        <meta name="keywords" content="@kimlik.Keywords">
    }
    @if (ViewBag.Canonical != null)
    {
        <link rel="canonical" href="@ViewBag.Canonical" />
    }
    <meta name="theme-color" content="#F6F8FB">
    <meta name="color-scheme" content="light dark">

    <link href="/Content/SiteLayout/assets/img/favicon.png" rel="icon">
    <link href="/Content/SiteLayout/assets/img/apple-touch-icon.png" rel="apple-touch-icon">

    <!-- Yazı tipleri: başlık Poppins, metin Open Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">

    <link href="/Content/SiteLayout/assets/vendor/animate.css/animate.min.css" rel="stylesheet">
    <link href="/Content/SiteLayout/assets/vendor/aos/aos.css" rel="stylesheet">
    <link href="/Content/SiteLayout/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="/Content/SiteLayout/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="/Content/SiteLayout/assets/vendor/boxicons/css/boxicons.min.css" rel="stylesheet">

    <!-- Şablon + kurumsal tema (tema.css şablonun üzerine yazar) -->
    <link href="/Content/SiteLayout/assets/css/style.css" rel="stylesheet">
    <link href="~/Content/SiteLayout/css/tema.css" rel="stylesheet">
    <!-- Açık/koyu tema: sayfa çizilmeden uygulanır (defer YOK) -->
    <script src="~/Content/tema-gecis.js"></script>
</head>
<body>
    <a class="kw-skip-link" href="#main">İçeriğe geç</a>

    <header id="header" class="fixed-top d-flex align-items-center">
        <div class="container d-flex justify-content-between align-items-center">

            <div class="logo">
                <h1 class="m-0">
                    <a href="/">
                        @if (!string.IsNullOrEmpty(logo))
                        {
                            <img src="@logo" alt="" width="40" height="40">
                        }
                        <span>@unvan</span>
                    </a>
                </h1>
            </div>

            <div class="kw-header-actions">
            <nav id="navbar" class="navbar" aria-label="Ana menü">
                <ul>
                    <li><a class="@aktifSinif("anasayfa")" aria-current="@aktifAria("anasayfa")" href="/">Ana Sayfa</a></li>
                    <li><a class="@aktifSinif("hakkimizda")" aria-current="@aktifAria("hakkimizda")" href="/Hakkimizda">Hakkımızda</a></li>
                    <li><a class="@aktifSinif("hizmetler")" aria-current="@aktifAria("hizmetler")" href="/Hizmetlerimiz">Hizmetlerimiz</a></li>
                    <li><a class="@aktifSinif("blog")" aria-current="@aktifAria("blog")" href="/BlogPost">Blog</a></li>
                    <li><a class="@aktifSinif("iletisim")" aria-current="@aktifAria("iletisim")" href="/Iletisim">İletişim</a></li>
                </ul>
                <button type="button" class="bi bi-list mobile-nav-toggle" aria-label="Menüyü aç/kapat" aria-controls="navbar"></button>
            </nav>
            <button type="button" class="kw-theme-toggle" data-tema-degistir aria-pressed="false" aria-label="Koyu temaya geç" title="Koyu temaya geç">
                <i class="bi bi-moon-stars kw-icon-light" aria-hidden="true"></i>
                <i class="bi bi-sun kw-icon-dark" aria-hidden="true"></i>
            </button>
            </div>

        </div>
    </header>

    <main id="main" tabindex="-1">
        @if (!string.IsNullOrEmpty(sayfaBasligi))
        {
            <section class="kw-page-header">
                <div class="container">
                    <h1>@sayfaBasligi</h1>
                    <nav aria-label="Konum">
                        <ol class="kw-breadcrumb">
                            <li><a href="/">Ana Sayfa</a></li>
                            @if (ViewBag.UstSayfaAd != null)
                            {
                                <li><a href="@ViewBag.UstSayfaUrl">@ViewBag.UstSayfaAd</a></li>
                            }
                            <li aria-current="page">@(ViewBag.KonumAd ?? sayfaBasligi)</li>
                        </ol>
                    </nav>
                </div>
            </section>
        }

        @RenderBody()

        @if (ViewBag.CtaGizle != true)
        {
            <section class="kw-cta" aria-labelledby="cta-baslik">
                <div class="container d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
                    <div>
                        <h2 id="cta-baslik">Projeniz için bizimle görüşün</h2>
                        <p>İhtiyacınızı dinleyelim, size en uygun çözümü birlikte planlayalım.</p>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <a class="kw-btn kw-btn-light" href="/Iletisim"><i class="bi bi-envelope" aria-hidden="true"></i> İletişime Geçin</a>
                        @if (telefonLink != null)
                        {
                            <a class="kw-btn kw-btn-ghost-light" href="@telefonLink"><i class="bi bi-telephone" aria-hidden="true"></i> @telefon</a>
                        }
                    </div>
                </div>
            </section>
        }
    </main>

    <footer id="footer">
        <div class="footer-top">
            <div class="container">
                <div class="row gy-4">

                    <div class="col-lg-4 col-md-6">
                        <h2>@unvan</h2>
                        @if (!string.IsNullOrEmpty((string)kimlik?.Description))
                        {
                            <p>@kimlik.Description</p>
                        }
                        <div class="social-links mt-3">
                            @if (!string.IsNullOrEmpty((string)iletisim?.Twitter))
                            {
                                <a href="https://twitter.com/@iletisim.Twitter" aria-label="X (Twitter)" rel="noopener" target="_blank"><i class="bx bxl-twitter" aria-hidden="true"></i></a>
                            }
                            @if (!string.IsNullOrEmpty((string)iletisim?.Facebook))
                            {
                                <a href="https://www.facebook.com/@iletisim.Facebook" aria-label="Facebook" rel="noopener" target="_blank"><i class="bx bxl-facebook" aria-hidden="true"></i></a>
                            }
                            @if (!string.IsNullOrEmpty((string)iletisim?.Instagram))
                            {
                                <a href="https://www.instagram.com/@iletisim.Instagram" aria-label="Instagram" rel="noopener" target="_blank"><i class="bx bxl-instagram" aria-hidden="true"></i></a>
                            }
                        </div>
                    </div>

                    <div class="col-lg-2 col-md-6 footer-links">
                        <h2>Menü</h2>
                        <ul>
                            <li><i class="bx bx-chevron-right" aria-hidden="true"></i> <a href="/">Ana Sayfa</a></li>
                            <li><i class="bx bx-chevron-right" aria-hidden="true"></i> <a href="/Hakkimizda">Hakkımızda</a></li>
                            <li><i class="bx bx-chevron-right" aria-hidden="true"></i> <a href="/Hizmetlerimiz">Hizmetlerimiz</a></li>
                            <li><i class="bx bx-chevron-right" aria-hidden="true"></i> <a href="/BlogPost">Blog</a></li>
                            <li><i class="bx bx-chevron-right" aria-hidden="true"></i> <a href="/Iletisim">İletişim</a></li>
                        </ul>
                    </div>

                    <div class="col-lg-3 col-md-6 footer-links">
                        <h2>Son Yazılar</h2>
                        <ul>
                            @foreach (var item in ViewBag.Blog ?? new List<CorporateWebsite.Models.Model.Blog>())
                            {
                                <li><i class="bx bx-chevron-right" aria-hidden="true"></i> <a href="@SeoHelper.BlogUrl(item.Baslik, item.BlogId)">@item.Baslik</a></li>
                            }
                        </ul>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <h2>İletişim</h2>
                        <address class="mb-0">
                            @if (!string.IsNullOrEmpty((string)iletisim?.Adres))
                            {
                                <p class="mb-2"><i class="bi bi-geo-alt me-2" aria-hidden="true"></i>@iletisim.Adres</p>
                            }
                            @if (telefonLink != null)
                            {
                                <p class="mb-2"><i class="bi bi-telephone me-2" aria-hidden="true"></i><a href="@telefonLink">@telefon</a></p>
                            }
                            @if (!string.IsNullOrEmpty(eposta))
                            {
                                <p class="mb-2"><i class="bi bi-envelope me-2" aria-hidden="true"></i><a href="mailto:@eposta">@eposta</a></p>
                            }
                        </address>
                    </div>

                </div>
            </div>
        </div>

        <div class="container">
            <div class="copyright">
                <p>&copy; @DateTime.Now.Year @unvan.TrimEnd('.'). Tüm hakları saklıdır.</p>
            </div>
        </div>
    </footer>

    <a href="#" class="back-to-top d-flex align-items-center justify-content-center" aria-label="Sayfanın başına dön"><i class="bi bi-arrow-up-short" aria-hidden="true"></i></a>

    <script src="/Content/SiteLayout/assets/vendor/aos/aos.js"></script>
    <script src="/Content/SiteLayout/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/Content/SiteLayout/js/site.js"></script>
    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Content/SiteLayout/js/yorum.js"></script>
    <script src="~/Content/SiteLayout/js/iletisim.js"></script>
</body>
</html>

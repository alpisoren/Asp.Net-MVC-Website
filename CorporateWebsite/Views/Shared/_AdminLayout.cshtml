@{
    // Yetki kontrolü AdminAuthorize filtresinde yapılır ve doğrulanan yönetici isteğe eklenir.
    var yonetici = CorporateWebsite.Helper.YoneticiOturumu.Aktif(Context);
    if (yonetici == null)
    {
        Response.Redirect("/yonetimpaneli/giris/");
        return;
    }

    string controller = ViewContext.RouteData.GetRequiredString("controller");
    string action = ViewContext.RouteData.GetRequiredString("action");
    bool adminMi = yonetici.AdminMi;
    string eposta = yonetici.Eposta ?? "";
    string basHarf = eposta.Length > 0 ? eposta.Substring(0, 1).ToUpperInvariant() : "?";

    // Menüde aktif öğe
    string aktif;
    if (controller == "Admin") { aktif = action == "Index" ? "ozet" : "adminler"; }
    else { aktif = controller.ToLowerInvariant(); }
    Func<string, string> aktifSinif = k => k == aktif ? "active" : null;
    Func<string, string> aktifAria = k => k == aktif ? "page" : null;

    // Konum yolu için bölüm adları
    var bolumler = new Dictionary<string, string[]>
    {
        { "blog", new[] { "Blog Yazıları", "/Blog/Index" } },
        { "kategori", new[] { "Kategoriler", "/Kategori/Index" } },
        { "yorum", new[] { "Yorumlar", "/Yorum/Index" } },
        { "hizmet", new[] { "Hizmetler", "/Hizmet/Index" } },
        { "slider", new[] { "Slider", "/Slider/Index" } },
        { "kimlik", new[] { "Site Kimliği", "/Kimlik/Index" } },
        { "hakkimizda", new[] { "Hakkımızda", "/Hakkimizda/Index" } },
        { "iletisim", new[] { "İletişim Bilgileri", "/Iletisim/Index" } },
        { "adminler", new[] { "Yöneticiler", "/Admin/Adminler" } }
    };
    string[] bolum = bolumler.ContainsKey(aktif) ? bolumler[aktif] : null;
    bool listeSayfasi = action == "Index" || action == "Adminler";
    string baslik = ViewBag.Title as string ?? "Yönetim Paneli";
    bool kartsiz = ViewBag.KartsizIcerik == true;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <meta name="theme-color" content="#F6F8FB">
    <meta name="color-scheme" content="light dark">
    <title>@baslik - Yönetim Paneli</title>

    <link href="@CorporateWebsite.Helper.VarlikHelper.Url("~/Content/SiteLayout/fonts/fonts.css")" rel="stylesheet">
    <link href="~/Content/AdminLayout/vendor/bootstrap-3.4.1/bootstrap.min.css" rel="stylesheet">
    <link href="~/Content/AdminLayout/css/font-awesome.min.css" rel="stylesheet" />
    <link href="~/Content/AdminLayout/vendor/datatables-1.13.11/jquery.dataTables.min.css" rel="stylesheet" />
    <link href="~/Content/AdminLayout/vendor/jodit-4.18.6/jodit.min.css" rel="stylesheet" />
    <link href="@CorporateWebsite.Helper.VarlikHelper.Url("~/Content/AdminLayout/css/panel.css")" rel="stylesheet" />
    <!-- Açık/koyu tema: sayfa çizilmeden uygulanır (defer YOK) -->
    <script src="@CorporateWebsite.Helper.VarlikHelper.Url("~/Content/tema-gecis.js")"></script>

</head>
<body class="kp-body">
    <a class="kp-skip-link" href="#main">İçeriğe geç</a>

    <aside class="kp-sidebar" id="kpSidebar" aria-label="Yönetim menüsü">
        <a class="kp-brand" href="/yonetimpaneli">
            <span class="kp-brand-mark" aria-hidden="true"><i class="fa fa-building"></i></span>
            Kurumsal Panel
        </a>

        <ul class="kp-nav">
            <li><a class="@aktifSinif("ozet")" aria-current="@aktifAria("ozet")" href="/yonetimpaneli"><i class="fa fa-th-large" aria-hidden="true"></i> Özet</a></li>

            <li class="kp-nav-group" role="presentation">İçerik</li>
            <li><a class="@aktifSinif("hizmet")" aria-current="@aktifAria("hizmet")" href="/Hizmet/Index"><i class="fa fa-briefcase" aria-hidden="true"></i> Hizmetler</a></li>
            <li><a class="@aktifSinif("blog")" aria-current="@aktifAria("blog")" href="/Blog/Index"><i class="fa fa-file-text-o" aria-hidden="true"></i> Blog Yazıları</a></li>
            <li><a class="@aktifSinif("kategori")" aria-current="@aktifAria("kategori")" href="/Kategori/Index"><i class="fa fa-folder-o" aria-hidden="true"></i> Kategoriler</a></li>
            <li>
                <a class="@aktifSinif("yorum")" aria-current="@aktifAria("yorum")" href="/Yorum/Index">
                    <i class="fa fa-comments-o" aria-hidden="true"></i> Yorumlar
                    <span class="kp-badge" title="Onay bekleyen yorumlar">@Html.Action("BekleyenYorumSayisi", "Admin")</span>
                </a>
            </li>

            @if (adminMi)
            {
                <li class="kp-nav-group" role="presentation">Site Ayarları</li>
                <li><a class="@aktifSinif("kimlik")" aria-current="@aktifAria("kimlik")" href="/Kimlik/Index"><i class="fa fa-id-card-o" aria-hidden="true"></i> Site Kimliği</a></li>
                <li><a class="@aktifSinif("hakkimizda")" aria-current="@aktifAria("hakkimizda")" href="/Hakkimizda/Index"><i class="fa fa-info-circle" aria-hidden="true"></i> Hakkımızda</a></li>
                <li><a class="@aktifSinif("slider")" aria-current="@aktifAria("slider")" href="/Slider/Index"><i class="fa fa-picture-o" aria-hidden="true"></i> Slider</a></li>
                <li><a class="@aktifSinif("iletisim")" aria-current="@aktifAria("iletisim")" href="/Iletisim/Index"><i class="fa fa-address-book-o" aria-hidden="true"></i> İletişim Bilgileri</a></li>
                <li><a class="@aktifSinif("adminler")" aria-current="@aktifAria("adminler")" href="/Admin/Adminler"><i class="fa fa-users" aria-hidden="true"></i> Yöneticiler</a></li>
            }
        </ul>

        <div class="kp-sidebar-footer">
            <ul class="kp-nav" style="padding:0">
                <li><a href="/" target="_blank" rel="noopener"><i class="fa fa-external-link" aria-hidden="true"></i> Siteyi Görüntüle</a></li>
            </ul>
        </div>
    </aside>

    <div class="kp-main">
        <header class="kp-topbar">
            <button type="button" class="kp-icon-btn kp-menu-toggle" id="kpMenuToggle" aria-controls="kpSidebar" aria-expanded="false" aria-label="Menüyü aç">
                <i class="fa fa-bars" aria-hidden="true"></i>
            </button>
            <div class="kp-topbar-spacer"></div>

            <button type="button" class="kp-icon-btn kp-theme-toggle" data-tema-degistir aria-pressed="false" aria-label="Koyu temaya geç" title="Koyu temaya geç">
                <i class="fa fa-moon-o kp-icon-light" aria-hidden="true"></i>
                <i class="fa fa-sun-o kp-icon-dark" aria-hidden="true"></i>
            </button>

            <a class="kp-icon-btn" href="/Yorum/Index" aria-label="Onay bekleyen yorumlar" title="Onay bekleyen yorumlar">
                <i class="fa fa-bell-o" aria-hidden="true"></i>
                <span class="kp-badge">@Html.Action("BekleyenYorumSayisi", "Admin")</span>
            </a>

            <div class="dropdown">
                <button type="button" class="kp-user dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <span class="kp-avatar" aria-hidden="true">@basHarf</span>
                    <span class="kp-user-meta">
                        <span>@eposta</span>
                        <small>@(adminMi ? "Admin" : "Editör")</small>
                    </span>
                    <i class="fa fa-angle-down" aria-hidden="true"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-right">
                    @if (adminMi)
                    {
                        <li><a href="/Admin/Adminler"><i class="fa fa-users" aria-hidden="true"></i> Yöneticiler</a></li>
                    }
                    <li>
                        @using (Html.BeginForm("Logout", "Admin", FormMethod.Post, new { @class = "cikis-formu" }))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="kp-dropdown-btn"><i class="fa fa-sign-out" aria-hidden="true"></i> Çıkış Yap</button>
                        }
                    </li>
                </ul>
            </div>
        </header>

        <main class="kp-content" id="main" tabindex="-1">
            <div class="kp-page-head">
                <div>
                    <ol class="kp-crumbs" aria-label="Konum">
                        <li><a href="/yonetimpaneli">Panel</a></li>
                        @if (bolum != null && !listeSayfasi)
                        {
                            <li><a href="@bolum[1]">@bolum[0]</a></li>
                        }
                    </ol>
                    <h1>@baslik</h1>
                </div>
                @if (ViewBag.YeniEkleUrl != null)
                {
                    <a class="btn btn-primary" href="@ViewBag.YeniEkleUrl"><i class="fa fa-plus" aria-hidden="true"></i>@(ViewBag.YeniEkleMetni ?? "Yeni Ekle")</a>
                }
            </div>

            @if (TempData["Basari"] != null)
            {
                <div class="alert alert-success" role="status">@TempData["Basari"]</div>
            }

            @if (kartsiz)
            {
                @RenderBody()
            }
            else
            {
                <div class="kp-card">
                    @RenderBody()
                </div>
            }
        </main>
    </div>

    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Content/AdminLayout/vendor/bootstrap-3.4.1/bootstrap.min.js"></script>
    <script src="~/Content/AdminLayout/vendor/datatables-1.13.11/jquery.dataTables.min.js"></script>
    <script src="~/Content/AdminLayout/vendor/jodit-4.18.6/jodit.min.js"></script>
    <script src="@CorporateWebsite.Helper.VarlikHelper.Url("~/Content/AdminLayout/js/admin.js")"></script>
</body>
</html>

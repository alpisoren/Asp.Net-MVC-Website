@model System.Web.Mvc.HandleErrorInfo
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bir hata oluştu</title>
    <style>
        body { font-family: Arial, sans-serif; background: #f5f5f5; color: #333; margin: 0; }
        .kutu { max-width: 520px; margin: 80px auto; background: #fff; padding: 32px; border-radius: 6px; box-shadow: 0 1px 4px rgba(0,0,0,.1); text-align: center; }
        h1 { font-size: 22px; margin-top: 0; }
        a { color: #1977cc; }
    </style>
</head>
<body>
    <div class="kutu">
        <h1>Üzgünüz, bir hata oluştu.</h1>
        <p>İsteğiniz işlenirken beklenmeyen bir sorun yaşandı. Lütfen daha sonra tekrar deneyiniz.</p>
        <p><a href="/">Ana sayfaya dön</a></p>
    </div>
</body>
</html>

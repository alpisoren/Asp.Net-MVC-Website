@model IEnumerable<CorporateWebsite.Models.Model.Iletisim>
@{
    ViewBag.Title = "İletişim Bilgileri";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    if (!Model.Any())
    {
        ViewBag.YeniEkleUrl = "/Iletisim/Create";
    }
}

<p class="kp-muted">Sitenin İletişim sayfasında ve alt bilgisinde (footer) görünen bilgiler. Sitede yalnızca ilk kayıt kullanılır.</p>

@if (!Model.Any())
{
    <div class="kp-empty"><i class="fa fa-address-book-o" aria-hidden="true"></i><p>İletişim bilgisi girilmemiş.</p><a class="btn btn-primary" href="/Iletisim/Create">Bilgileri girin</a></div>
}

@foreach (var item in Model)
{
    <dl class="dl-horizontal">
        <dt>Adres</dt><dd>@(item.Adres ?? "—")</dd>
        <dt>Telefon</dt><dd>@(item.Telefon ?? "—")</dd>
        <dt>E-posta</dt><dd>@(item.Fax ?? "—")</dd>
        <dt>WhatsApp</dt><dd>@(item.Whatsapp ?? "—")</dd>
        <dt>Facebook</dt><dd>@(item.Facebook ?? "—")</dd>
        <dt>X (Twitter)</dt><dd>@(item.Twitter ?? "—")</dd>
        <dt>Instagram</dt><dd>@(item.Instagram ?? "—")</dd>
    </dl>
    <div class="kp-form-actions">
        <a class="btn btn-primary" href="/Iletisim/Edit/@item.IletisimId"><i class="fa fa-pencil" aria-hidden="true"></i>Düzenle</a>
        <a class="btn btn-default" href="/Iletisim/Delete/@item.IletisimId"><i class="fa fa-trash-o" aria-hidden="true"></i>Sil</a>
    </div>
}
